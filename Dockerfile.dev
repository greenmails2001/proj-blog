FROM node:18-bookworm-slim

WORKDIR /var/lib/ghost

# Install system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        git \
        python3 \
        make \
        g++ \
        ca-certificates \
        wget && \
    rm -rf /var/lib/apt/lists/*

# Install yarn globally (Ghost uses yarn workspaces)
RUN npm install -g yarn

# Copy package files
COPY package*.json yarn.lock ./
COPY .yarn ./.yarn
COPY .yarnrc.yml ./

# Install all dependencies (monorepo)
RUN yarn install

# Copy source code
COPY . .

# Expose Ghost port
EXPOSE 2368

# Development command
CMD ["yarn", "dev"]